    "db:migrate": "prisma migrate deploy",
    "start": "HOSTNAME=0.0.0.0 PORT=8080 node .next/standalone/server.js",
    "start:self-hosted": "HOSTNAME=0.0.0.0 PORT=8080 node .next/standalone/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "next": "16.2.6",
    "react": "19.2.6",
