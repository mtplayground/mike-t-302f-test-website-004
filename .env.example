# Required server environment variables.
# Keep real values in deployment secrets or ignored local env files.

# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# API key for the email provider used by lead notifications.
EMAIL_API_KEY="replace-with-email-provider-api-key"

# Email address that receives lead notifications.
NOTIFICATION_RECIPIENT="founder@example.com"

# Verified sender address configured in Resend.
NOTIFICATION_SENDER="mike-t-302f-test-website-004 <leads@example.com>"

# Public canonical URL used for metadata, Open Graph, and Twitter card URLs.
NEXT_PUBLIC_SITE_URL="https://example.com"
